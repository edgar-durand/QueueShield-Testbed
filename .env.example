# === Database ===
DATABASE_URL=postgresql://queueshield:queueshield_secret@localhost:5433/queueshield?schema=public

# === Redis ===
REDIS_URL=redis://localhost:6380

# === Security ===
SESSION_SECRET=replace-with-a-random-64-character-string-for-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# === Queue Configuration ===
QUEUE_PROCESS_INTERVAL_MS=3000
QUEUE_BATCH_SIZE=5
ACCESS_TOKEN_TTL_SECONDS=120

# === Risk Thresholds (0-100) ===
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=60
RISK_THRESHOLD_HIGH=85

# === Bot-detection enforcement ===
# When true, /api/queue/join REQUIRES a valid JS challenge + proof-of-work.
# Defaults to true in production, false otherwise.
ENFORCE_CHALLENGES=

# Number of additional trusted reverse proxies in front of the app.
# 0 = use the right-most x-forwarded-for entry (set by your edge proxy).
TRUSTED_PROXY_COUNT=0

# === CAPTCHA (optional — leave empty to use custom challenges) ===
# Get keys at https://www.hcaptcha.com/
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# === Admin Dashboard (exposed to client for NEXT_PUBLIC_ vars) ===
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=change-this-strong-password
